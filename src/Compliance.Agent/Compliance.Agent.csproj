<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- File description and product name: what UAC, Task Manager and Windows notifications show for the exe. -->
    <AssemblyTitle>终端合规客户端服务</AssemblyTitle>
    <Product>终端合规客户端</Product>
    <Company>终端合规</Company>
    <!-- Building elsewhere is still allowed for tests and fixture demos. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- StorePackages calls the Windows Runtime PackageManager through function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Compliance.Core/Compliance.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
</Project>
