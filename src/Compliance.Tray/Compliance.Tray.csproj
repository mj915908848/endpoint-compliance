<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- File description and product name: what UAC, Task Manager and Windows notifications show for the exe. -->
    <AssemblyTitle>终端合规客户端</AssemblyTitle>
    <Product>终端合规客户端</Product>
    <Company>终端合规</Company>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Compliance.Core/Compliance.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Drawn by scripts/make_tray_icons.py. -->
    <EmbeddedResource
      Include="Assets\*.ico"
      LogicalName="Compliance.Tray.Assets.%(Filename)%(Extension)"
    />
  </ItemGroup>
</Project>
