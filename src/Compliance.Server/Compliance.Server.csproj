<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <!-- Self-contained packages trim the framework (scripts/package.py). Our own assemblies stay whole, and JSON keeps
       reflection-based serialization, since nothing here uses source-generated contracts yet. Endpoints bind at run
       time as in tests rather than through the compile-time generator trimming would turn on. -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimMode>partial</TrimMode>
    <EnableRequestDelegateGenerator>false</EnableRequestDelegateGenerator>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Compliance.Core/Compliance.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../ui/dist')">
    <Content Remove="wwwroot/**/*" />
    <Content
      Include="../../ui/dist/**/*"
      Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
