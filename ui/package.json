{
  "name": "endpoint-compliance-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api": "openapi-typescript openapi.json -o src/api.gen.ts && prettier --write src/api.gen.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.104.0",
    "antd": "6.6.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
