<!--
  The client as an MSI: dotnet build deploy/windows/msi -p:ClientDir=<published client folder> -p:ProductVersion=1.2.3
  Builds on Windows only; scripts/package.py runs it when asked for the MSI.
-->
<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>compliance-client</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
    <!-- Known and intended, so they stay out of the build output:
         WIX1149: the plain ServiceConfig only sets FailureActionsWhen; the restarts already use util:ServiceConfig.
         ICE61: AllowSameVersionUpgrades lets the same version reinstall over itself.
         ICE60: a bundled versioned file has no language; Windows Installer still compares its version on upgrade. -->
    <SuppressSpecificWarnings>1149</SuppressSpecificWarnings>
    <SuppressIces>ICE60;ICE61</SuppressIces>
    <DefineConstants>ClientDir=$(ClientDir);ProductVersion=$(ProductVersion);AssetsDir=$(MSBuildThisFileDirectory)..\..\..\src\Compliance.Tray\Assets</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
