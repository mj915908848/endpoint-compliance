<!--
  Installs the client service and tray. The service starts at once and waits until the device is enrolled:
  - interactively, the MSI then opens the tray's enrollment window (address and code, 登记配置.json beside the MSI
    fills them in);
  - silently, msiexec /i compliance-client.msi SERVERURL=https://... CODE=... /qn enrolls during the install and
    rolls it back when the enrollment fails.
  An upgrade keeps the data directory and so the enrollment; it also takes over a client installed by the earlier
  install scripts. Uninstalling removes the service, the files and the data directory.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="终端合规客户端"
    Manufacturer="终端合规"
    Version="$(var.ProductVersion)"
    UpgradeCode="9F8E1BD6-8B65-451C-A804-EC10B87F4500"
    Scope="perMachine"
    Language="2052"
    Codepage="936"
    Compressed="yes"
  >
    <SummaryInformation Codepage="936" Description="终端合规客户端" />
    <MajorUpgrade
      DowngradeErrorMessage="本机已安装更新版本的终端合规客户端。"
      AllowSameVersionUpgrades="yes"
    />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="app.ico" SourceFile="$(var.AssetsDir)\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- The tray is closed below; Restart Manager would only ask about it. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <!-- No system restore point: where System Protection is on, creating one keeps every install and removal on
         "正在配置" for up to minutes, and restoring one would not undo the service or the enrollment anyway. -->
    <Property Id="MSIFASTINSTALL" Value="1" />
    <Property Id="SERVERURL" Secure="yes" />
    <Property Id="CODE" Secure="yes" Hidden="yes" />
    <!-- Asked for by removal when the policy sets an uninstall password: msiexec /x ... UNINSTALLPASSWORD=... -->
    <Property Id="UNINSTALLPASSWORD" Secure="yes" Hidden="yes" />
    <!-- The enrollment's and the password check's command lines hold the code and the password. -->
    <Property Id="EnrollAgent" Hidden="yes" />
    <Property Id="VerifyUninstall" Hidden="yes" />

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ComplianceAgent" />
    </StandardDirectory>

    <ComponentGroup Id="Client" Directory="INSTALLFOLDER">
      <Files Include="$(var.ClientDir)\**">
        <Exclude Files="$(var.ClientDir)\Compliance.Agent.exe" />
      </Files>
      <Component Id="Service">
        <File Id="AgentExe" Source="$(var.ClientDir)\Compliance.Agent.exe" KeyPath="yes" />
        <ServiceInstall
          Name="ComplianceAgent"
          DisplayName="Compliance Agent"
          Description="终端合规客户端服务"
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Account="LocalSystem"
          Arguments="--config &quot;[CommonAppDataFolder]ComplianceAgent\agent.json&quot;"
        >
          <ServiceConfig FailureActionsWhen="failedToStopOrReturnedError" OnInstall="yes" OnReinstall="yes" />
          <!-- Windows Installer's own failure actions fail with error 5 for restart actions (it opens the service
               without SERVICE_START), so the restarts go through the util extension. -->
          <util:ServiceConfig
            FirstFailureActionType="restart"
            SecondFailureActionType="restart"
            ThirdFailureActionType="restart"
            RestartServiceDelayInSeconds="60"
            ResetPeriodInDays="1"
          />
        </ServiceInstall>
        <ServiceControl Id="Service" Name="ComplianceAgent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="TrayAtSignIn">
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
          Name="ComplianceTray"
          Type="string"
          Value="&quot;[INSTALLFOLDER]Compliance.Tray.exe&quot;"
          KeyPath="yes"
        />
      </Component>

      <!-- Windows names and draws the tray's notifications after the Start menu shortcut carrying its
           AppUserModelID (TrayApp.AppUserModelId); without one they read "NotifyIconGeneratedAumid_...". -->
      <Component Id="TrayShortcut">
        <Shortcut
          Id="TrayShortcut"
          Directory="ProgramMenuFolder"
          Name="终端合规客户端"
          Description="终端合规客户端通知中心"
          Target="[INSTALLFOLDER]Compliance.Tray.exe"
          Arguments="--notices"
          WorkingDirectory="INSTALLFOLDER"
        >
          <ShortcutProperty Key="System.AppUserModel.ID" Value="ComplianceAgent.Tray" />
        </Shortcut>
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\Classes\AppUserModelId\ComplianceAgent.Tray"
          Name="DisplayName"
          Type="string"
          Value="终端合规客户端"
          KeyPath="yes"
        />
      </Component>

      <!-- Uninstalling removes the data directory and what a script install or an earlier release left in the program
           folder, through RemoveFile rows that roll back with the rest. Their paths must be known before costing, so
           the program folder is remembered in the registry. Not when an upgrade removes this version: the next one
           keeps the enrollment and the files. Only a folder named ComplianceAgent is removed whole. -->
      <Component Id="RemoveLeftovers">
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\ComplianceAgent"
          Name="InstallFolder"
          Type="string"
          Value="[INSTALLFOLDER]"
          KeyPath="yes"
        />
        <util:RemoveFolderEx Id="RemoveAgentData" Property="AGENTDATAFOLDER" Condition="NOT UPGRADINGPRODUCTCODE" />
        <util:RemoveFolderEx
          Id="RemoveProgramLeftovers"
          Property="REMEMBEREDINSTALLFOLDER"
          Condition="NOT UPGRADINGPRODUCTCODE AND REMEMBEREDINSTALLFOLDER ~&gt;&gt; &quot;\ComplianceAgent\&quot;"
        />
      </Component>
    </ComponentGroup>

    <Property Id="REMEMBEREDINSTALLFOLDER">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\ComplianceAgent" Name="InstallFolder" Type="raw" Bitness="always64" />
    </Property>
    <!-- RemoveFolderEx expands the variable itself; directory properties are not resolved yet when it runs. -->
    <Property Id="AGENTDATAFOLDER" Value="%ProgramData%\ComplianceAgent\" />

    <Feature Id="Main" Title="终端合规客户端">
      <ComponentGroupRef Id="Client" />
    </Feature>

    <!-- The tray runs in every signed-in session; it would hold its files open. -->
    <util:CloseApplication Id="CloseTray" Target="Compliance.Tray.exe" TerminateProcess="1" RebootPrompt="no" />

    <!-- Before the service first starts: a data directory a standard user created is removed, not used. -->
    <SetProperty
      Id="PrepareAgentData"
      Value="&quot;[#AgentExe]&quot; --prepare-install"
      Before="PrepareAgentData"
      Sequence="execute"
    />
    <CustomAction
      Id="PrepareAgentData"
      BinaryRef="Wix4UtilCA_X64"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="check"
    />

    <SetProperty
      Id="EnrollAgent"
      Value="&quot;[#AgentExe]&quot; --config &quot;[CommonAppDataFolder]ComplianceAgent\agent.json&quot; --server &quot;[SERVERURL]&quot; --enroll --code &quot;[CODE]&quot;"
      Before="EnrollAgent"
      Sequence="execute"
      Condition="SERVERURL AND CODE"
    />
    <CustomAction
      Id="EnrollAgent"
      BinaryRef="Wix4UtilCA_X64"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes"
    />

    <!-- Removing the client (not upgrading it) first takes out the browser rules it added, while the program and its
         record of those rules are still there and the service is stopped, then clears the data directory but the
         enrollment (NativeDataDirectory.ClearForUninstall). A failure does not stop the removal. -->
    <SetProperty
      Id="RemoveBrowserRules"
      Value="&quot;[#AgentExe]&quot; --uninstall-cleanup"
      Before="RemoveBrowserRules"
      Sequence="execute"
    />
    <CustomAction
      Id="RemoveBrowserRules"
      BinaryRef="Wix4UtilCA_X64"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="ignore"
    />

    <!-- Removing the client (not upgrading it) first checks the uninstall password the policy sets, before the service
         stops: a wrong or missing one fails the removal, which rolls back, and the service reports the attempt. -->
    <SetProperty
      Id="VerifyUninstall"
      Value="&quot;[#AgentExe]&quot; --config &quot;[CommonAppDataFolder]ComplianceAgent\agent.json&quot; --verify-uninstall --password &quot;[UNINSTALLPASSWORD]&quot;"
      Before="VerifyUninstall"
      Sequence="execute"
    />
    <CustomAction
      Id="VerifyUninstall"
      BinaryRef="Wix4UtilCA_X64"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes"
    />

    <InstallExecuteSequence>
      <Custom
        Action="VerifyUninstall"
        Before="StopServices"
        Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"
      />
      <Custom
        Action="RemoveBrowserRules"
        After="StopServices"
        Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"
      />
      <Custom Action="PrepareAgentData" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="EnrollAgent" After="PrepareAgentData" Condition="NOT REMOVE AND SERVERURL AND CODE" />
    </InstallExecuteSequence>

    <!-- In the signed-in user's process, not elevated; the window asks for elevation when it enrolls. -->
    <CustomAction
      Id="LaunchSetup"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[INSTALLFOLDER]Compliance.Tray.exe&quot; --setup &quot;[OriginalDatabase]&quot;"
      Return="asyncNoWait"
      Impersonate="yes"
    />
    <InstallUISequence>
      <Custom Action="LaunchSetup" After="ExecuteAction" Condition="NOT Installed AND NOT REMOVE" />
    </InstallUISequence>
  </Package>
</Wix>
