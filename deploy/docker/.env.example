# 复制为 .env 后修改：cp .env.example .env && chmod 600 .env
# 改了 .env 后运行 docker compose up -d 生效。

# 数据库密码，只用字母和数字（可用 openssl rand -hex 16 生成）。部署后不要再改。
DB_PASSWORD=

# 管理员账号和初始密码，只在第一次启动时创建。密码至少 16 位，不含 " 和 \ 。
ADMIN_USER=admin
ADMIN_PASSWORD=

# 对外的 HTTPS 端口。
HTTPS_PORT=443

# 管理端镜像，三选一：
# 1. 镜像仓库（默认）：不用改。COMPLIANCE_VERSION 可固定版本，如 0.2.25。
COMPLIANCE_IMAGE=ghcr.io/mj915908848/compliance-server
COMPLIANCE_VERSION=latest
# 2. 打包好的镜像：先 docker load -i compliance-server-<版本>.tar.gz，再把上面两行改成 load 显示的名字和版本，如
#    COMPLIANCE_IMAGE=compliance-server
#    COMPLIANCE_VERSION=0.2.25
# 3. 从源码构建（部署目录是源码仓库里的 deploy/docker）：去掉下一行的 #。
# COMPOSE_FILE=compose.yml:compose.build.yml

# 证书放在 certs 目录。PEM 格式（含中间证书的证书 + 私钥）：
Kestrel__Certificates__Default__Path=/certs/cert.pem
Kestrel__Certificates__Default__KeyPath=/certs/key.pem
# PFX 格式时删掉上面两行，改为：
# Kestrel__Certificates__Default__Path=/certs/cert.pfx
# Kestrel__Certificates__Default__Password=证书密码
