# 复制为 .env 后修改。.env 含密码，不要提交到仓库。

# 数据库密码：随便一串长随机字符，只在容器之间使用。只能用字母和数字。
DB_PASSWORD=

# 首个管理员账号，只在第一次启动时创建；之后改这里不会改已有账号的密码。
# 密码至少 16 位；不要包含 " 和 \ 。
ADMIN_USER=admin
ADMIN_PASSWORD=

# 管理端版本，如 0.2.24；不写即最新版。
# COMPLIANCE_VERSION=

# 对外的 HTTPS 端口。
HTTPS_PORT=443

# 证书放在 certs 目录，文件名按实际修改。
# PEM 格式（证书 .crt/.pem，含中间证书的完整链 + 私钥 .key）：
Kestrel__Certificates__Default__Path=/certs/cert.pem
Kestrel__Certificates__Default__KeyPath=/certs/key.pem
# PFX 格式时删掉上面两行，改为：
# Kestrel__Certificates__Default__Path=/certs/cert.pfx
# Kestrel__Certificates__Default__Password=证书密码
